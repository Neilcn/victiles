      "settings": {
        "custom_liquid": "<victiles-sale-countdown data-end=\"2026-12-01T00:00:00+11:00\" hidden>\n  <a class=\"vct-sale-inner\" href=\"/pages/black-friday-sale\">\n    <div class=\"vct-sale-copy\">\n      <p class=\"vct-sale-title\">Black Friday Sale ends soon!</p>\n      <p class=\"vct-sale-subtitle\">Lock in your savings. Sale ends in:</p>\n    </div>\n\n    <div class=\"vct-sale-clock\"\n         role=\"timer\"\n         aria-live=\"off\"\n         aria-label=\"Time remaining until the Black Friday Sale ends\">\n      <div>\n        <strong data-unit=\"days\">00</strong>\n        <span>Days</span>\n      </div>\n      <b aria-hidden=\"true\">:</b>\n      <div>\n        <strong data-unit=\"hours\">00</strong>\n        <span>Hours</span>\n      </div>\n      <b aria-hidden=\"true\">:</b>\n      <div>\n        <strong data-unit=\"mins\">00</strong>\n        <span>Mins</span>\n      </div>\n      <b aria-hidden=\"true\">:</b>\n      <div>\n        <strong data-unit=\"secs\">00</strong>\n        <span>Secs</span>\n      </div>\n    </div>\n  </a>\n</victiles-sale-countdown>\n\n<style>\n  victiles-sale-countdown[hidden] {\n    display: none !important;\n  }\n\n  victiles-sale-countdown {\n    display: block;\n    background: #E46258;\n    color: #fff;\n    width: 100%;\n    box-sizing: border-box;\n  }\n\n  victiles-sale-countdown * {\n    box-sizing: border-box;\n  }\n\n  victiles-sale-countdown .vct-sale-inner {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 36px;\n    max-width: 1400px;\n    margin: 0 auto;\n    padding: 24px;\n    color: #fff;\n    text-decoration: none;\n  }\n\n  victiles-sale-countdown .vct-sale-copy {\n    text-align: center;\n    min-width: 0;\n  }\n\n  victiles-sale-countdown .vct-sale-title {\n    margin: 0;\n    color: #fff;\n    font-family: inherit;\n    font-size: clamp(22px, 2.3vw, 32px);\n    line-height: 1.2;\n    font-weight: 700;\n  }\n\n  victiles-sale-countdown .vct-sale-subtitle {\n    margin: 7px 0 0;\n    color: #fff;\n    font-size: 16px;\n    line-height: 1.4;\n  }\n\n  victiles-sale-countdown .vct-sale-clock {\n    display: flex;\n    flex-shrink: 0;\n    align-items: center;\n    gap: 10px;\n    background: #fff;\n    color: #202020;\n    border-radius: 16px;\n    padding: 12px 18px;\n  }\n\n  victiles-sale-countdown .vct-sale-clock > div {\n    min-width: 48px;\n    text-align: center;\n  }\n\n  victiles-sale-countdown .vct-sale-clock strong {\n    display: block;\n    color: #202020;\n    font-family: Arial, sans-serif;\n    font-size: 36px;\n    font-weight: 700;\n    line-height: 1.1;\n    font-variant-numeric: tabular-nums;\n  }\n\n  victiles-sale-countdown .vct-sale-clock span {\n    display: block;\n    margin-top: 4px;\n    color: #444;\n    font-size: 12px;\n    line-height: 1.2;\n  }\n\n  victiles-sale-countdown .vct-sale-clock > b {\n    align-self: flex-start;\n    margin-top: 3px;\n    font-size: 25px;\n    line-height: 1.2;\n  }\n\n  victiles-sale-countdown .vct-sale-inner:focus-visible {\n    outline: 3px solid #202020;\n    outline-offset: -4px;\n  }\n\n  @media (max-width: 900px) {\n    victiles-sale-countdown .vct-sale-inner {\n      flex-direction: column;\n      gap: 16px;\n      padding: 20px 16px;\n    }\n  }\n\n  @media (max-width: 380px) {\n    victiles-sale-countdown .vct-sale-clock {\n      gap: 7px;\n      padding: 10px 12px;\n    }\n\n    victiles-sale-countdown .vct-sale-clock > div {\n      min-width: 42px;\n    }\n\n    victiles-sale-countdown .vct-sale-clock strong {\n      font-size: 30px;\n    }\n\n    victiles-sale-countdown .vct-sale-subtitle {\n      font-size: 14px;\n    }\n  }\n</style>\n\n<script>\n  if (!customElements.get('victiles-sale-countdown')) {\n    customElements.define(\n      'victiles-sale-countdown',\n      class extends HTMLElement {\n        connectedCallback() {\n          clearInterval(this.vctInterval);\n\n          this.vctEnd = Date.parse(this.dataset.end);\n\n          this.vctDigits = ['days', 'hours', 'mins', 'secs'].map(\n            unit => this.querySelector('[data-unit=\"' + unit + '\"]')\n          );\n\n          if (this.vctUpdate()) {\n            this.vctInterval = setInterval(\n              () => this.vctUpdate(),\n              1000\n            );\n          }\n        }\n\n        disconnectedCallback() {\n          clearInterval(this.vctInterval);\n        }\n\n        vctUpdate() {\n          const remaining = this.vctEnd - Date.now();\n\n          if (!Number.isFinite(remaining) || remaining <= 0) {\n            this.hidden = true;\n            clearInterval(this.vctInterval);\n\n            const section = this.closest('.shopify-section');\n\n            if (section) {\n              section.style.display = 'none';\n            }\n\n            return false;\n          }\n\n          const total = Math.ceil(remaining / 1000);\n\n          const values = [\n            Math.floor(total / 86400),\n            Math.floor(total / 3600) % 24,\n            Math.floor(total / 60) % 60,\n            total % 60\n          ];\n\n          values.forEach((value, index) => {\n            this.vctDigits[index].textContent =\n              String(value).padStart(2, '0');\n          });\n\n          this.hidden = false;\n          return true;\n        }\n      }\n    );\n  }\n</script>"
      }
