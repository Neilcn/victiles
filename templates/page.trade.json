        "custom_liquid": "<div class=\"victiles-trade-section\">\n  <h2>Why Join VICTiles Trade?</h2>\n\n  <div class=\"victiles-trade-benefits\">\n\n    <div class=\"trade-benefit-item\">\n      <h3>1. Exclusive Trade Pricing</h3>\n      <p>Access special trade pricing across selected VICTiles products and save more on every project.</p>\n    </div>\n\n    <div class=\"trade-benefit-item\">\n      <h3>2. Personalised Trade Support</h3>\n      <p>Get dedicated support from our team to help with product selection, quotes and ongoing orders.</p>\n    </div>\n\n    <div class=\"trade-benefit-item\">\n      <h3>3. Flexible Ordering</h3>\n      <p>Order what you need for projects of any size, with a straightforward and flexible purchasing process.</p>\n    </div>\n\n    <div class=\"trade-benefit-item\">\n      <h3>4. Australia-Wide Delivery</h3>\n      <p>Keep your projects moving with convenient delivery options available across Australia.</p>\n    </div>\n\n  </div>\n</div>\n\n<style>\n.victiles-trade-section {\n  max-width: 1400px;\n  margin: 0 auto;\n  padding: 50px 35px 55px;\n}\n\n.victiles-trade-section > h2 {\n  text-align: center;\n  font-size: 28px;\n  font-weight: 700;\n  margin: 0 0 42px;\n  line-height: 1.3;\n}\n\n.victiles-trade-benefits {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 45px;\n  text-align: center;\n}\n\n.trade-benefit-item h3 {\n  margin: 0 0 16px;\n  font-size: 20px;\n  font-weight: 700;\n  line-height: 1.4;\n}\n\n.trade-benefit-item p {\n  margin: 0 auto;\n  max-width: 280px;\n  font-size: 16px;\n  line-height: 1.65;\n}\n\n@media screen and (max-width: 990px) {\n  .victiles-trade-benefits {\n    grid-template-columns: repeat(2, 1fr);\n    gap: 40px 35px;\n  }\n}\n\n@media screen and (max-width: 600px) {\n  .victiles-trade-section {\n    padding: 40px 20px;\n  }\n\n  .victiles-trade-section > h2 {\n    font-size: 24px;\n    margin-bottom: 30px;\n  }\n\n  .victiles-trade-benefits {\n    grid-template-columns: 1fr;\n    gap: 30px;\n  }\n\n  .trade-benefit-item h3 {\n    font-size: 18px;\n    margin-bottom: 10px;\n  }\n\n  .trade-benefit-item p {\n    font-size: 14px;\n  }\n}\n</style>"
