{% assign background_rgb = section.settings.background_color | color_to_rgb %}
{% assign text_rgb = section.settings['color-body-text'] | color_to_rgb %}

<style>
    [data-section-id="{{ section.id }}"]
    {
        {% if background_rgb != 'rgba(0, 0, 0, 0.0)' %}
          --color-background: {{ section.settings.background_color }};
        {% endif %}

        {% if section.settings.margin-top %}
            --section-gap-top: {{ section.settings.margin-top }}px;
        {% endif %}

        {% if section.settings.margin-bottom %}
            --section-gap-bottom: {{ section.settings.margin-bottom }}px;
        {% endif %}

    }

    [data-section-id="{{ section.id }}"] .headline__title,
    [data-section-id="{{ section.id }}"] .hero__text
      {
          {% if text_rgb != 'rgba(0, 0, 0, 0.0)' %}
            --color-custom-text: {{ section.settings.color-body-text }};
          {% endif %}
      }

    {%- for block in section.blocks -%}
      [data-block-id="{{ block.id }}"]
      {

          --font-headline-scale-desk: {{ block.settings.size_heading | divided_by: 100.0 }};

          --font-headline-scale: {{ block.settings.size_heading_mobile | divided_by: 100.0 }};

      }
  {%- endfor -%}

  .contact-form__product {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }

  .contact-form__product-image {
    width: 72px;
    height: 72px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .contact-form__product-info {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .contact-form__product-title {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
  }

  .contact-form__product-vendor {
    margin: 0;
    font-size: 13px;
    color: #3e3f46;
  }

  .form__field--tile-usage {
    border: none;
    padding: 0;
    margin: 0 0 20px;
  }

  .form__field--tile-usage .form__field__label {
    display: block;
    margin-bottom: 8px;
  }

  .form__field__checkbox-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-right: 16px;
    font-weight: normal;
  }
</style>

<div data-section-id="{{ section.id }}" class="wt-contact__form form__full">
  <div class="contact-form__product">
    <img
      class="contact-form__product-image"
      src="{{ product.featured_image | image_url: width: 144 }}"
      width="72"
      height="72"
      alt="{{ product.featured_image.alt | escape }}"
      loading="lazy"
    >
    <div class="contact-form__product-info">
      <p class="contact-form__product-title">{{ product.title }}</p>
      <p class="contact-form__product-vendor">{{ product.vendor }}</p>
    </div>
  </div>
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'heading' -%}
        <h2
          data-block-id="{{ block.id }}"
          class="hero__title {% if settings.animations %} scroll-trigger animate--slide-in {% endif %} {% if settings.disabled_animations_on_mobile %} disabled-on-mobile {% endif %} {% if block.settings.heading_disable_on_mobile == true %} hero__title--mobile{% endif %}"
        >
          {% render 'headline', title: block.settings.heading %}
        </h2>
      {%- when 'paragraph' -%}
        <div class="hero__text form__text{% if block.settings.text_disable_on_mobile == true %} hero__text--mobile{% endif %} rte">
          {{ block.settings.paragraph }}
        </div>
      {%- when 'email_form' -%}
        <div class="form__container {% if settings.animations %} scroll-trigger animate--slide-in {% endif %} {% if settings.disabled_animations_on_mobile %} disabled-on-mobile {% endif %}">
          <div class="contact-form">
            {%- form 'contact', id: 'ContactForm', class: 'isolate' -%}
              {%- if form.posted_successfully? -%}
                <div class="form__message">
                  <div class="form__success-field" tabindex="-1" autofocus>
                    <p>{{ 'templates.contact.form.post_success' | t }}</p>
                  </div>
                </div>
              {%- elsif form.errors -%}
                <div class="form__message">
                  <div class="form__error-field">
                    {{ form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email }}
                  </div>
                </div>
              {%- endif -%}
              <div class="form__fieldset">
                <label
                  class="form__field form__field--name"
                  for="ContactFormName-{{ section.id }}"
                >
                  <input
                    type="text"
                    name="contact[name]"
                    id="ContactFormName-{{ section.id }}"
                    class="form__field__input"
                    placeholder=" "
                    value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                  >
                  <span class="form__field__label">{{ 'templates.contact.form.name' | t }}</span>
                </label>

                <label
                  class="form__field form__field--phone"
                  for="ContactFormPhone-{{ section.id }}"
                >
                  <input
                    type="text"
                    name="contact[phone]"
                    id="ContactFormPhone-{{ section.id }}"
                    class="form__field__input"
                    placeholder=" "
                    value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                  >
                  <span class="form__field__label">{{ 'templates.contact.form.phone' | t }}</span>
                </label>
              </div>

              <label
                class="form__field form__field--email"
                for="ContactFormEmail-{{ section.id }}"
              >
                <input
                  type="text"
                  name="contact[email]"
                  id="ContactFormEmail-{{ section.id }}"
                  class="form__field__input"
                  placeholder=" "
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                >
                <span class="form__field__label">{{ 'templates.contact.form.email' | t }}" * </span>
              </label>

              <label
                class="form__field form__field--square-metres"
                for="ContactFormSquareMetres-{{ section.id }}"
              >
                <input
                  type="text"
                  name="contact[Approximate square metres needed]"
                  id="ContactFormSquareMetres-{{ section.id }}"
                  class="form__field__input"
                  placeholder=" "
                  value="{% if form['Approximate square metres needed'] %}{{ form['Approximate square metres needed'] }}{% endif %}"
                >
                <span class="form__field__label">Approximate square metres needed *</span>
              </label>

              <label
                class="form__field form__field--best-describes"
                for="ContactFormBestDescribes-{{ section.id }}"
              >
                <select
                  name="contact[Which best describes you?]"
                  id="ContactFormBestDescribes-{{ section.id }}"
                  class="form__field__input"
                >
                  <option value="Homeowner">Homeowner</option>
                  <option value="Designer / Architect">Designer / Architect</option>
                  <option value="Builder / Trade Contractor">Builder / Trade Contractor</option>
                  <option value="Developer">Developer</option>
                  <option value="Retailer / Wholesaler (Business)">Retailer / Wholesaler (Business)</option>
                </select>
                <span class="form__field__label">Which best describes you?</span>
              </label>

              <label
                class="form__field form__field--project-type"
                for="ContactFormProjectType-{{ section.id }}"
              >
                <select
                  name="contact[What type of project is this for?]"
                  id="ContactFormProjectType-{{ section.id }}"
                  class="form__field__input"
                >
                  <option value="New Build">New Build</option>
                  <option value="Renovation">Renovation</option>
                  <option value="Commercial">Commercial</option>
                  <option value="Other">Other</option>
                </select>
                <span class="form__field__label">What type of project is this for?</span>
              </label>

              <label
                class="form__field form__field--timeline"
                for="ContactFormTimeline-{{ section.id }}"
              >
                <select
                  name="contact[When are you hoping to have the tiles ready?]"
                  id="ContactFormTimeline-{{ section.id }}"
                  class="form__field__input"
                >
                  <option value="As Soon As Possible">As Soon As Possible</option>
                  <option value="Within 1 Month">Within 1 Month</option>
                  <option value="Within 1-3 Months">Within 1-3 Months</option>
                  <option value="Within 3-6 Months">Within 3-6 Months</option>
                  <option value="Over 6 Months">Over 6 Months</option>
                </select>
                <span class="form__field__label">When are you hoping to have the tiles ready?</span>
              </label>

              <fieldset class="form__field form__field--tile-usage">
                <legend class="form__field__label">Where will the tiles be used?</legend>
                <label class="form__field__checkbox-label">
                  <input type="checkbox" name="contact[Where will the tiles be used?][]" value="Bathroom">
                  Bathroom
                </label>
                <label class="form__field__checkbox-label">
                  <input type="checkbox" name="contact[Where will the tiles be used?][]" value="Kitchen">
                  Kitchen
                </label>
                <label class="form__field__checkbox-label">
                  <input type="checkbox" name="contact[Where will the tiles be used?][]" value="Laundry">
                  Laundry
                </label>
                <label class="form__field__checkbox-label">
                  <input type="checkbox" name="contact[Where will the tiles be used?][]" value="Livingroom">
                  Livingroom
                </label>
                <label class="form__field__checkbox-label">
                  <input type="checkbox" name="contact[Where will the tiles be used?][]" value="Outdoor">
                  Outdoor
                </label>
                <label class="form__field__checkbox-label">
                  <input type="checkbox" name="contact[Where will the tiles be used?][]" value="Other">
                  Other
                </label>
              </fieldset>

              <input
                type="hidden"
                name="contact[Product]"
                value="{{ product.title }}"
              >

              <label
                class="form__field"
                for="ContactFormComment-{{ section.id }}"
              >
                <textarea
                  class="form__field__textarea"
                  name="contact[comment]"
                  id="ContactFormComment-{{ section.id }}"
                  placeholder=" "
                  rows="6"
                  value="{% if form[comment] %}{{ form[comment] }}{% elsif customer %}{{ customer.comment }}{% endif %}"
                >{{- form.body -}}</textarea>
                <span class="form__field__label">{{- 'templates.contact.form.comment' | t -}}</span>
              </label>
              {% comment %}<a href="#" class="test-1">{% endcomment %}
              <button
                aria-label="{{ 'aria-label.contact-form' | t }}"
                class="hero__button--primary {% if block.settings.button_select != 'primary' %} hero__button--secondary {% endif %}{% if block.settings.button_select == 'link' %} hero__button--link {% endif %} block__button block{% if block.settings.disable_on_mobile %}__button--mobile{% endif %}"
              >
                <span> {{ block.settings.button_label }}</span>
                <span class="wt-newsletter__send__text">{{ 'aria-label.contact-form' | t }}</span>
              </button>
              {% comment %}</a>{% endcomment %}
            {% endform %}
          </div>
        </div>
    {%- endcase -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Contact form sample",
  "tag": "section",
  "class": "spaced-section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.global.colors",
      "info": "t:sections.global.colors-info"
    },
    {
      "type": "color",
      "id": "color-body-text",
      "default": "transparent",
      "label": "t:sections.settings.settings.text-color.label"
    },
    {
      "type": "color",
      "id": "background_color",
      "default": "transparent",
      "label": "t:sections.settings.settings.background-color.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.section_spacing"
    },
    {
      "type": "range",
      "id": "margin-top",
      "min": 0,
      "max": 100,
      "unit": "px",
      "step": 4,
      "default": 20,
      "label": "t:sections.settings.settings.distance-top.label"
    },
    {
      "type": "range",
      "id": "margin-bottom",
      "min": 0,
      "max": 100,
      "unit": "px",
      "step": 4,
      "default": 20,
      "label": "t:sections.settings.settings.distance-bottom.label",
      "info": "t:sections.settings.settings.distance-bottom.info"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:sections.newsletter.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "textarea",
          "id": "heading",
          "default": "Contact form",
          "label": "t:sections.settings.settings.heading.label"
        },
        {
          "type": "checkbox",
          "id": "heading_disable_on_mobile",
          "label": "t:sections.global.disable_on_mobile",
          "default": false
        },
        {
          "type": "range",
          "id": "size_heading",
          "min": 50,
          "max": 500,
          "step": 10,
          "default": 100,
          "label": "t:sections.settings.settings.size-heading.label",
          "unit": "%"
        },
        {
          "type": "range",
          "id": "size_heading_mobile",
          "min": 80,
          "max": 300,
          "step": 10,
          "default": 100,
          "label": "t:sections.settings.settings.size-heading-mobile.label",
          "unit": "%"
        }
      ]
    },
    {
      "type": "paragraph",
      "name": "t:sections.newsletter.blocks.paragraph.name",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "paragraph",
          "default": "<p>Be the first to know about new collections and exclusive offers.</p>",
          "label": "t:sections.settings.settings.text.label"
        },
        {
          "type": "checkbox",
          "id": "text_disable_on_mobile",
          "label": "t:sections.global.disable_on_mobile",
          "default": false
        }
      ]
    },
    {
      "type": "email_form",
      "name": "t:sections.newsletter.blocks.email_form.name",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "button_select",
          "options": [
            {
              "value": "primary",
              "label": "t:sections.settings.settings.button_select.primary.label"
            },
            {
              "value": "secondary",
              "label": "t:sections.settings.settings.button_select.secondary.label"
            },
            {
              "value": "link",
              "label": "t:sections.settings.settings.button_select.link.label"
            }
          ],
          "default": "primary",
          "label": "t:sections.settings.settings.button_select.default.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact form sample",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "paragraph"
        },
        {
          "type": "email_form"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
