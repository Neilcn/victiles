<section class="vt-spring-banner" style="--vt-banner-bg:{{ section.settings.background }}">
  <h1 class="vt-spring-sr">{{ section.settings.heading | escape }}</h1>
  {% if section.settings.image != blank %}
    <picture>
      {% if section.settings.mobile_image != blank %}
        <source media="(max-width: 760px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">
      {% endif %}
      {{ section.settings.image | image_url: width: 2648 | image_tag: widths: '750, 1100, 1500, 2000, 2648', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.heading }}
    </picture>
  {% elsif request.design_mode %}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'vt-spring-banner-placeholder' }}
  {% endif %}
</section>

{% stylesheet %}
.vt-spring-banner{width:100%;aspect-ratio:2648/594;background:var(--vt-banner-bg,#efefe3);overflow:hidden}
.vt-spring-banner picture{display:block;width:100%;height:100%}
.vt-spring-banner img,.vt-spring-banner-placeholder{display:block;width:100%;height:100%;object-fit:contain}
.vt-spring-sr{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}
@media(max-width:760px){.vt-spring-banner{aspect-ratio:2.2398568}}
{% endstylesheet %}

{% schema %}
{
  "name": "Spring banner",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Accessible page title",
      "default": "Spring Look Inspiration"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop banner"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile banner (optional)"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#efefe3"
    }
  ],
  "presets": [
    {
      "name": "Spring banner"
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}