<script>
  document.addEventListener('DOMContentLoaded', function () {
    const sectionRoot = document.getElementById('project-gallery-blocks-{{ section.id }}');

    if (!sectionRoot) {
      return;
    }

    const filterRoot = sectionRoot.querySelector('#project-gallery-filter-{{ section.id }}');

    if (filterRoot) {
      const clearBtn = filterRoot.querySelector('.project-gallery-clear-filters');
      const targetSections = Array.from(
        sectionRoot.querySelectorAll('.project-gallery-section[data-project-gallery-filter-target="true"]')
      );

      if (!targetSections.length || !clearBtn) {
        filterRoot.style.display = 'none';
      } else {
        const activeFilters = {
          room: [],
          colour: [],
          style: []
        };

        function parseValues(value) {
          if (!value) {
            return [];
          }

          return value
            .split(',')
            .map(function (entry) {
              return entry.trim();
            })
            .filter(function (entry) {
              return entry.length > 0;
            });
        }

        function getUniqueValues(group) {
          const values = new Set();

          targetSections.forEach(function (sectionEl) {
            parseValues(sectionEl.getAttribute('data-' + group)).forEach(function (value) {
              values.add(value);
            });
          });

          return Array.from(values).sort();
        }

        function createButtons(group, values) {
          const groupEl = filterRoot.querySelector('.project-gallery-filter-group[data-filter-group="' + group + '"]');
          if (!groupEl) {
            return;
          }

          const container = groupEl.querySelector('.project-gallery-filter-buttons');
          if (!container) {
            return;
          }

          if (!values.length) {
            groupEl.style.display = 'none';
            return;
          }

          values.forEach(function (value) {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'project-gallery-filter-btn';
            btn.textContent = value;
            btn.dataset.group = group;
            btn.dataset.value = value;

            btn.addEventListener('click', function () {
              toggleFilter(group, value, btn);
            });

            container.appendChild(btn);
          });
        }

        function toggleFilter(group, value, buttonEl) {
          if (buttonEl.disabled) {
            return;
          }

          const currentValues = activeFilters[group];
          const valueIndex = currentValues.indexOf(value);

          if (valueIndex !== -1) {
            currentValues.splice(valueIndex, 1);
            buttonEl.classList.remove('active');
          } else {
            currentValues.push(value);
            buttonEl.classList.add('active');
          }

          applyFilters();
        }

        function sectionMatchesFilters(sectionEl, filters) {
          return Object.keys(filters).every(function (group) {
            const selectedValues = filters[group];

            if (!selectedValues.length) {
              return true;
            }

            const sectionValues = parseValues(sectionEl.getAttribute('data-' + group));

            return selectedValues.some(function (selectedValue) {
              return sectionValues.indexOf(selectedValue) !== -1;
            });
          });
        }

        function hasAnyMatch(filters) {
          return targetSections.some(function (sectionEl) {
            return sectionMatchesFilters(sectionEl, filters);
          });
        }

        function updateButtonAvailability() {
          const buttons = filterRoot.querySelectorAll('.project-gallery-filter-btn');

          buttons.forEach(function (btn) {
            const group = btn.dataset.group;
            const value = btn.dataset.value;
            const isActive = activeFilters[group].indexOf(value) !== -1;

            if (isActive) {
              btn.classList.remove('unavailable');
              btn.disabled = false;
              return;
            }

            const testFilters = {
              room: activeFilters.room.slice(),
              colour: activeFilters.colour.slice(),
              style: activeFilters.style.slice()
            };

            testFilters[group].push(value);

            const isAvailable = hasAnyMatch(testFilters);

            btn.classList.toggle('unavailable', !isAvailable);
            btn.disabled = !isAvailable;
          });
        }

        function applyFilters() {
          const hasActiveFilters = Object.keys(activeFilters).some(function (group) {
            return activeFilters[group].length > 0;
          });

          targetSections.forEach(function (sectionEl) {
            const matches = sectionMatchesFilters(sectionEl, activeFilters);

            if (matches) {
              sectionEl.classList.remove('project-gallery-filter-hidden');
            } else {
              sectionEl.classList.add('project-gallery-filter-hidden');
            }
          });

          if (hasActiveFilters) {
            clearBtn.classList.add('visible');
          } else {
            clearBtn.classList.remove('visible');
          }

          updateButtonAvailability();
        }

        clearBtn.addEventListener('click', function () {
          Object.keys(activeFilters).forEach(function (group) {
            activeFilters[group] = [];
          });

          filterRoot.querySelectorAll('.project-gallery-filter-btn').forEach(function (btn) {
            btn.classList.remove('active');
          });

          applyFilters();
        });

        ['room', 'colour', 'style'].forEach(function (group) {
          createButtons(group, getUniqueValues(group));
        });

        applyFilters();
      }
    }

    sectionRoot.querySelectorAll('[data-project-gallery-instance="true"]').forEach(function (instance) {
      const lightbox = instance.querySelector('.project-gallery-lightbox');
      const lightboxContent = lightbox ? lightbox.querySelector('.project-gallery-lightbox-content') : null;
      const closeBtn = lightbox ? lightbox.querySelector('.project-gallery-lightbox-close') : null;

      if (!lightbox || !lightboxContent || !closeBtn) {
        return;
      }

      instance.querySelectorAll('.project-gallery-zoom-btn').forEach(function (btn) {
        btn.addEventListener('click', function (event) {
          event.stopPropagation();

          const itemContent = btn.closest('.project-gallery-item-content');
          if (!itemContent) {
            return;
          }

          const clone = itemContent.cloneNode(true);
          const zoomBtn = clone.querySelector('.project-gallery-zoom-btn');

          if (zoomBtn) {
            zoomBtn.remove();
          }

          lightboxContent.innerHTML = '';
          lightboxContent.appendChild(clone);

          lightbox.classList.add('active');
          document.body.style.overflow = 'hidden';
        });
      });

      function closeLightbox() {
        lightbox.classList.remove('active');
        document.body.style.overflow = '';
        lightboxContent.innerHTML = '';
      }

      closeBtn.addEventListener('click', closeLightbox);

      lightbox.addEventListener('click', function (event) {
        if (event.target === lightbox) {
          closeLightbox();
        }
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && lightbox.classList.contains('active')) {
          closeLightbox();
        }
      });
    });
  });
</script>