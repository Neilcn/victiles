{% doc %}
  Renders the sample contact button and modal configured in the product section.
  @param {product} product - The current product.
  @param {array} blocks - The parent product section's blocks.
{% enddoc %}
{%- for block in blocks -%}
  {%- if block.type == 'contact_form_popup' and block.settings.size_link != empty -%}
    <div class="wt-product__content wt-product__information-popup">
        {% if block.settings.size_icon != 'none' %}
            <div class="wt-product__icon">
                {% render 'icon-accordion', icon: block.settings.size_icon %}
            </div>
        {% endif %}
        <div class="wt-product__page">
            <modal-opener
                    class="wt-product__opener no-js-hidden quick-add-hidden"
                    data-modal="#ContactFormPopupModal-{{ block.id }}"
                    {{ block.shopify_attributes }}
            >
                <button
                        aria-label="{{ block.settings.size_link }}"
                        id="ContactFormPopup-{{ block.id }}"
                        class="button"
                        style="background:#000; color:#fff; padding:16px 24px; width:100%;"
                        type="button"
                        aria-haspopup="dialog"
                >
                    {{ block.settings.size_link }}
                </button>
            </modal-opener>
        </div>
    </div>

    <modal-dialog
            id="ContactFormPopupModal-{{ block.id }}"
            class="wt-product__modal"
            {{ block.shopify_attributes }}
    >
        <div
                role="dialog"
                aria-label="{{ block.settings.size_link }}"
                aria-modal="true"
                class="wt-product__modal--content"
                tabindex="-1"
        >
            <div class="wt-product__modal-top">
                <div
                        id="ModalClose-{{ block.id }}"
                        role="button"
                        class="wt-product__modal--toggle"
                        aria-label="{{ 'accessibility.close' | t }}"
                >
                    {% render 'icons',
                            id: 'close',
                            icon_id: 'wt-announcement__close',
                            icon_class: 'wt-product__modal--toggle'
                    %}
                </div>
            </div>
            <div class="wt-product__modal--content-info rte">
                {% render 'contact-form-product-info', product: product %}
                {% render 'contact-form-fields', unique_id: block.id, button_select: 'primary' %}
            </div>
        </div>
    </modal-dialog>
  {%- endif -%}
{%- endfor -%}