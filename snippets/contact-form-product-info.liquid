{% comment %}
  Renders the product image/title/vendor summary shown above the contact
  form sample. Extracted from sections/contact-form-sample.liquid so it can
  be reused from other sections (a section can't render another section
  directly with the `section` tag).

  Accepts:
  - product: the product object to display (defaults to the global `product`)
{% endcomment %}
<style>
  .contact-form__product {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }

  .contact-form__product-image {
    width: 72px;
    height: 72px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .contact-form__product-info {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .contact-form__product-title {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
  }

  .contact-form__product-vendor {
    margin: 0;
    font-size: 13px;
    color: #3e3f46;
  }
</style>

<div class="contact-form__product">
  <img
    class="contact-form__product-image"
    src="{{ product.featured_image | image_url: width: 144 }}"
    width="72"
    height="72"
    alt="{{ product.featured_image.alt | escape }}"
    loading="lazy"
  >
  <div class="contact-form__product-info">
    <p class="contact-form__product-title">{{ product.title }}</p>
    <p class="contact-form__product-vendor">{{ product.vendor }}</p>
  </div>
</div>
